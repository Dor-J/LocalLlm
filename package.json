{
  "name": "local-first-ai-chat-monorepo",
  "private": true,
  "engines": {
    "node": ">=20.10.0",
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "backend:build": "docker compose --env-file infra/docker/compose.env -f infra/docker/docker-compose.yml build",
    "backend:start": "docker compose --env-file infra/docker/compose.env -f infra/docker/docker-compose.yml up",
    "backend:stop": "docker compose --env-file infra/docker/compose.env -f infra/docker/docker-compose.yml down",
    "migration:run": "docker compose --env-file infra/docker/compose.env -f infra/docker/docker-compose.yml exec api alembic upgrade head",
    "seed:dev": "docker compose --env-file infra/docker/compose.env -f infra/docker/docker-compose.yml exec api python -m app.scripts.seed_dev",
    "api:setup": "bun run scripts/api-venv.ts setup",
    "api:test": "bun run scripts/api-venv.ts pytest",
    "api:lint": "bun run scripts/api-venv.ts ruff",
    "api:format": "bun run scripts/api-venv.ts black",
    "api:alembic": "bun run scripts/api-venv.ts alembic",
    "api:seed": "bun run scripts/api-venv.ts seed",
    "api:dev": "bun run scripts/api-venv.ts uvicorn",
    "frontend:dev": "bun --cwd apps/web dev",
    "frontend:test": "bun --cwd apps/web test",
    "frontend:lint": "bun --cwd apps/web lint",
    "frontend:e2e": "bun --cwd apps/web e2e",
    "local:start": "bun run scripts/local-start.ts",
    "format:check": "bun --cwd apps/web format:check",
    "codegen:openapi": "bun run scripts/codegen-openapi.ts"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
