COMPOSE_PROJECT_NAME=localfirstchat
APP_NAME=local-first-ai-chat-api
DOCKER_DNS_PRIMARY=1.1.1.1
DOCKER_DNS_SECONDARY=8.8.8.8
POSTGRES_DB=localchat
POSTGRES_USER=localchat
POSTGRES_PASSWORD=localchat
POSTGRES_PORT=5432
API_PORT=8000
DATABASE_URL=postgresql+psycopg://localchat:localchat@postgres:5432/localchat
CORS_ORIGINS=http://localhost:3000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_ALLOWED_MODELS=qwen3.5:2b,gemma4:e2b,gemma4-e2b-uncensored-q5_k_p
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_MODEL_CACHE_TTL_SECONDS=30
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=localchat
MINIO_ROOT_PASSWORD=localchat-secret
# API credentials must match MinIO root (or a dedicated IAM user) for local dev
MINIO_ACCESS_KEY=localchat
MINIO_SECRET_KEY=localchat-secret
MINIO_BUCKET_NAME=localchat-images
MINIO_SECURE=false
EXPERIMENTAL_AGENT_ORCHESTRATION_ENABLED=false
AGENT_ORCHESTRATOR_BACKEND=noop
MAX_REQUEST_BODY_BYTES=131072
MAX_CHAT_CONTENT_CHARS=8000
MAX_CHAT_TITLE_CHARS=120
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_IMAGES_PER_SESSION=24
MAX_SOURCE_CONTENT_CHARS=20000
MAX_EMBEDDING_DIMENSIONS=4096
MAX_SESSIONS=500
MAX_MESSAGES_PER_SESSION=400
MAX_DOCUMENT_CHUNKS=20000
MAX_EMBEDDING_RECORDS=20000
MAX_DATABASE_BYTES=1073741824
STORAGE_WARNING_RATIO=0.8
