APP_NAME=local-first-ai-chat-api
LOG_FORMAT=text
DATABASE_URL=postgresql+psycopg://localchat:localchat@postgres:5432/localchat
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_TIMEOUT=30
DB_SLOW_QUERY_LOG_MS=200
CORS_ORIGINS=http://localhost:3000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_ALLOWED_MODELS=qwen3.5:2b,gemma4:e2b,nsfw-flash-q4_k_m,dan-qwen3-1.7b-q3_k_m,gemma4-e2b-uncensored-q5_k_p
OLLAMA_TIMEOUT_SECONDS=600
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=localchat
MINIO_SECRET_KEY=localchat-secret
MINIO_BUCKET_NAME=localchat-images
MINIO_SECURE=false
EXPERIMENTAL_AGENT_ORCHESTRATION_ENABLED=false
AGENT_ORCHESTRATOR_BACKEND=noop
ENABLE_DEVICE_CONTROL=false
LOVENSE_BRIDGE_BASE_URL=http://host.docker.internal:8091
LOVENSE_BRIDGE_TIMEOUT_SECONDS=10
# Optional: must match LOVENSE_BRIDGE_SHARED_SECRET on the Windows bridge when auth is enabled
LOVENSE_BRIDGE_TOKEN=
DEVICE_CONTROL_REQUIRE_EXPLICIT_ENABLE=true
ENABLE_DEVICE_CONTROL_LLM_INTENT=false
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_IMAGES_PER_SESSION=24
MAX_IMAGE_LIST_PER_PAGE=200
UVICORN_WORKERS=2
UVICORN_RELOAD=false
STORAGE_USAGE_LOG_MIN_INTERVAL_SECONDS=60
